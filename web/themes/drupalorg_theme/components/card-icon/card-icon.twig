{% set has_url = url is not empty ? 'yes' : 'no' %}
{% set heading_id = 'card-icon-heading'|clean_unique_id %}
{% set overlay_label = text|default(description|striptags|trim)|default(icon|default('Learn more'|t)) %}

{% set tile =
  html_cva(
    base: ['@container relative rounded-lg p-4 transition duration-300 ease-in-out hover:-translate-y-1 sm:p-5 lg:p-8'],
    variants: {
      hasUrl: {
        yes: 'group cursor-pointer',
        no: ''
      },
      backgroundColor: {
        primary: 'bg-navy text-white transition duration-300 hover:bg-navy/80',
        white: 'border border-medium-gray bg-white text-navy transition duration-300 hover:border-drupal-blue hover:bg-white/90 hover:text-darkest-gray/90',
        navy: 'bg-navy text-white transition duration-300 hover:bg-lightest-gray/80',
        noColor: 'border border-medium-gray bg-none text-darkest-gray transition duration-300 hover:border-drupal-blue hover:shadow-md'
      },
      tileSize: {
        square: 'aspect-square',
        '4:3': 'aspect-4/3',
        '16:9': 'aspect-16/9',
        noSize: 'aspect-none'
      }
    }
  )
%}

{% set tile_classes =
  tile.apply({
    hasUrl: has_url,
    backgroundColor: background_color|default('noColor'),
    tileSize: tile_size|default('noSize'),
    borderRadius: border_radius|default('noRadius')
  })
%}

{% set icon_container =
  html_cva(
    base: ['flex', 'w-full'],
    variants: {
      iconAlign: {
        left: 'justify-start',
        center: 'justify-center',
        right: 'justify-end'
      }
    }
  )
%}

{% set icon_container_classes =
  icon_container.apply({
    iconAlign: icon_align|default('center')
  })
%}

{% set icon_style_attr =
  html_cva(
    base: [''],
    variants: {
      iconStyle: {
        primary: 'text-navy',
        'drupal-blue': 'text-drupal-blue',
        primary_background: 'mb-2 rounded-md bg-lightest-blue p-2 text-drupal-blue',
        secondary_background: 'mb-2 rounded-md bg-light-gray p-2 text-dark-gray'
      }
    }
  )
%}

{% set icon_style_classes =
  icon_style_attr.apply({
    iconStyle: icon_style
  })
%}

{% set icon_size_map = {
  small: 'small',
  medium: 'medium',
  large: 'large',
  'extra-large': 'extra-large'
} %}

{% set text_container =
  html_cva(
    base: ['w-full'],
    variants: {
      textAlign: {
        left: 'text-start',
        center: 'text-center',
        right: 'text-end'
      }
    }
  )
%}

{% set text_container_classes =
  text_container.apply({
    textAlign: text_align|default('center')
  })
%}

{% set overlay_link =
  html_cva(
    base: [
      'absolute inset-0 z-10 rounded-lg',
      'focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-drupal-blue focus-visible:outline-solid'
    ]
  )
%}

{% set text_classes = ['flex w-full flex-col'] %}
{% set heading_classes = ['text-xl font-semibold'] %}
{% set description_classes = ['mt-1 font-body text-md [&>*:first-child]:mt-0 [&>*:last-child]:mb-0'] %}

{% set inner_content =
  html_cva(
    base: ['flex h-full flex-col'],
    variants: {
      hasUrl: {
        yes: 'transition duration-300 ease-in-out group-hover:scale-103',
        no: ''
      }
    }
  )
%}

<div class="{{ tile_classes }}">
  <div
    class="{{
    inner_content.apply({
      hasUrl: has_url
    })
    }}"
  >
    {% if icon %}
      <div class="{{ icon_container_classes }} mb-2">
        <div class="{{ icon_style_classes }}">
          {{
            include(
              '@drupalorg_theme/components/icon/icon.twig',
              {
                icon: icon,
                icon_size: icon_size_map[icon_size]|default('medium')
              },
              with_context: false
            )
          }}
        </div>
      </div>
    {% endif %}
    <div class="{{ text_container_classes }}">
      {% if text is not empty or description is not empty %}
        <div class="{{ text_classes|join(' ') }}">
          {% if text is not empty %}
            <h3 id="{{ heading_id }}" class="{{ heading_classes|join(' ') }}">{{ text }}</h3>
          {% endif %}
          {% if description is not empty %}
            <span class="{{ description_classes|join(' ') }}">{{ description }}</span>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>

  {% if url is not empty %}
    {% if text is not empty %}
      <a href="{{ url }}" class="{{ overlay_link.apply({}) }}" aria-labelledby="{{ heading_id }}"></a>
    {% else %}
      <a href="{{ url }}" class="{{ overlay_link.apply({}) }}"><span class="sr-only">{{ overlay_label }}</span></a>
    {% endif %}
  {% endif %}
</div>
