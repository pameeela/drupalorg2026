{#
/**
 * @file
 * Single mega-menu destination link (level 3).
 *
 * Expects:
 * - link_item: menu item array
 */
#}
{% set link_title = link_item.title %}
{% set is_external = link_item.url.external ?? false %}
{% set description = link_item.entity is not empty ? link_item.entity.field_description.value|default('') : '' %}

<a
  href="{{ link_item.url }}"
  class="flex flex-col gap-1 rounded-sm no-underline hover:no-underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-drupal-blue"
>
  <span class="inline-flex items-baseline gap-1.5 font-medium text-dark-blue transition duration-300 hover:text-navy">
    {{ link_title }}
    {% if is_external %}
      <span class="inline-flex" aria-hidden="true">
        {{
          include(
            '@drupalorg/components/icon/icon.twig',
            {
              icon: 'arrow-up-right',
              icon_size: 'extra-extra-small'
            },
            with_context: false
          )
        }}
      </span>
      <span class="sr-only">{{ '(external link)'|t }}</span>
    {% endif %}
  </span>
  {% if description %}
    <span class="text-sm text-dark-gray">{{ description }}</span>
  {% endif %}
</a>
