{#
/**
 * @file
 * Main navigation mega menu (menu_item_extras).
 *
 * Tree contract (editorial):
 * - Level 1 (Product, Solutions, …): <nolink> triggers. Optional promo fields
 *   on this item (eyebrow, heading, description, link) render in the panel.
 * - Level 2: <nolink> group labels (columns).
 * - Level 3: real destination links; optional field_description body copy.
 */
#}
{% set menu_label = menu_label|default('Main navigation'|t) %}

{# Top level links #}
{% set trigger_classes =
  [
    'relative',
    'inline-flex',
    'w-full',
    'cursor-pointer',
    'items-center',
    'justify-between',
    'gap-2',
    'border-b-2',
    'border-b-transparent',
    'bg-transparent',
    'px-2',
    'py-3',
    'text-[15px]',
    'font-medium',
    'text-darkest-gray',
    'transition-colors',
    'duration-150',
    'hover:bg-lightest-gray',
    'group-[.is-open]/mega:text-navy',
    'md:justify-center',
    'md:px-3',
    'md:py-7',
    'md:hover:border-b-drupal-blue',
    'md:hover:bg-transparent',
    'md:group-[.is-open]/mega:border-b-drupal-blue',
    'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-drupal-blue'
  ]|join(' ')
%}

{% set panel_classes =
  [
    'bg-white',
    'md:absolute',
    'md:top-full',
    'md:right-0',
    'md:left-0',
    'md:z-[501]',
    'md:border-t',
    'md:border-b',
    'md:border-light-gray/50',
    'md:shadow-[0_24px_40px_-24px_rgba(10,26,58,0.28)]'
  ]|join(' ')
%}

{% set panel_body_classes =
  [
    'container',
    'mx-auto',
    'grid',
    'gap-8',
    'bg-white',
    'ps-2',
    'pe-6',
    'py-4',
    'md:px-12',
    'md:grid-cols-[1fr_auto]',
    'md:gap-10',
    'md:pt-10',
    'md:pb-11'
  ]|join(' ')
%}

{% set columns_classes = ['flex', 'min-w-0', 'flex-col', 'gap-8', 'md:flex-row', 'md:flex-wrap', 'md:gap-10']|join(' ') %}

{% set column_classes = 'flex min-w-0 flex-col flex-1 gap-6' %}
{% set group_classes_base = 'flex min-w-0 flex-col gap-4' %}
{% set group_label_classes = 'text-[11px] font-medium text-dark-gray/90 uppercase' %}
{% set links_classes = 'flex flex-col gap-4' %}

{% set promo_classes =
  [
    'flex',
    'min-w-0',
    'shrink-0',
    'flex-col',
    'gap-3',
    'rounded-lg',
    'border',
    'border-light-gray/60',
    'bg-lightest-gray',
    'p-7',
    'md:w-[380px]',
    'md:max-w-[380px]'
  ]|join(' ')
%}

<nav aria-label="{{ menu_label }}" data-mega-menu>
  <ul class="m-0 flex list-none flex-col gap-1 p-0 md:flex-row md:items-center md:gap-1 md:ps-6">
    {% for item in items %}
      {% set title = item.title %}
      {% set panel_id = (title ~ '-mega-panel-' ~ loop.index)|clean_id %}
      {% set promo_entity = item.entity is defined and item.entity is not empty ? item.entity : null %}
      {% set has_promo = promo_entity and promo_entity.field_heading.value is not empty %}

      <li class="group/mega relative md:static" data-mega-menu-item>
        <button
          type="button"
          id="{{ panel_id }}-trigger"
          class="{{ trigger_classes }}"
          aria-expanded="false"
          aria-controls="{{ panel_id }}"
          data-mega-menu-trigger
        >
          <span>{{ title }}</span>
          <span
            class="inline-flex opacity-55 transition-transform duration-[160ms] group-[.is-open]/mega:rotate-180 motion-reduce:transition-none"
            aria-hidden="true"
          >
            {{
              include(
                '@drupalorg/components/icon/icon.twig',
                {
                  icon: 'caret-down',
                  icon_size: 'extra-extra-small'
                },
                with_context: false
              )
            }}
          </span>
        </button>

        <div id="{{ panel_id }}" class="{{ panel_classes }}" role="region" aria-labelledby="{{ panel_id }}-trigger" data-mega-menu-panel hidden>
          <div class="{{ panel_body_classes }}">
            <div class="{{ columns_classes }}">
              {% for child in item.below %}
                {% set group_label_id = (panel_id ~ '-' ~ child.title ~ '-' ~ loop.index)|clean_id %}
                <div class="{{ column_classes }}" role="group" aria-labelledby="{{ group_label_id }}">
                  <div class="{{ group_classes_base }}">
                    <div id="{{ group_label_id }}" class="{{ group_label_classes }}">
                      {{ child.title }}
                    </div>
                    <div class="{{ links_classes }}">
                      {% for link_item in child.below %}
                        {% include '@drupalorg/templates/navigation/mega-menu-link.html.twig' with {
                          link_item: link_item
                        } only %}
                      {% endfor %}
                    </div>
                  </div>
                </div>
              {% endfor %}
            </div>

            {% if has_promo %}
              {% set promo_link_item = promo_entity.field_link.isEmpty ? null : promo_entity.field_link[0] %}
              <div class="{{ promo_classes }}">
                {% if promo_entity.field_eyebrow.value %}
                  <div class="text-xs font-semibold tracking-wide text-dark-blue uppercase">
                    {{ promo_entity.field_eyebrow.value }}
                  </div>
                {% endif %}
                <div class="font-heading text-xl font-semibold tracking-tight text-darkest-blue">
                  {{ promo_entity.field_heading.value }}
                </div>
                {% if promo_entity.field_description.value %}
                  <div class="text-sm text-darkest-gray">
                    {{ promo_entity.field_description.value }}
                  </div>
                {% endif %}
                {% if promo_link_item %}
                  {{
                    include(
                      '@drupalorg/components/button/button.twig',
                      {
                        variant: 'blue-link',
                        label: promo_link_item.title|default('Learn more'|t),
                        href: promo_link_item.url,
                        icon: 'arrow-right',
                        btn_classes: 'mt-1'
                      },
                      with_context: false
                    )
                  }}
                {% endif %}
              </div>
            {% endif %}
          </div>
        </div>
      </li>
    {% endfor %}
  </ul>
</nav>
