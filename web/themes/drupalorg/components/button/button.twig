{% set button_variant = variant|default('primary') %}
{% set is_disabled = disabled|default(false) %}
{% set has_icon = icon is not empty %}
{% set is_full_width = full_width|default(false) ? 'yes' : 'no' %}

{% set button_variants =
  html_cva(
    base: [
      'group inline-flex items-center justify-center gap-2.5',
      'rounded-full px-5 py-2.5 text-sm leading-normal font-medium',
      'cursor-pointer no-underline transition duration-300 ease-in-out hover:no-underline',
      'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-drupal-blue',
      'disabled:pointer-events-none disabled:opacity-50'
    ],
    variants: {
      variant: {
        primary: 'bg-primary text-primary-foreground shadow-md shadow-navy/50 hover:bg-primary/85',
        'drupal-blue': 'bg-drupal-blue text-darkest-blue shadow-md shadow-navy/50 hover:bg-drupal-blue/85',
        'light-blue': 'bg-lightest-blue text-primary shadow-md shadow-medium-gray/80 hover:bg-lightest-blue/85',
        'white-outline': 'border border-primary bg-white text-primary hover:bg-white/90',
        'transparent-white': 'border border-white bg-transparent text-white hover:text-light-blue',
        'transparent-navy': 'border border-navy bg-transparent text-navy hover:text-darkest-blue',
        'navy-link': 'px-0! py-1! text-navy hover:text-navy/80',
        'blue-link': 'px-0! py-1! text-dark-blue hover:text-dark-blue/80',
        white: 'bg-white text-primary hover:bg-white/90'
      },
      fullWidth: {
        yes: 'w-full',
        no: 'w-fit'
      }
    }
  )
%}

{% set icon_variants =
  html_cva(
    base: ['transition duration-300 ease-in-out'],
    compound_variants: [
      {
        icon: ['arrow-right', 'arrow-left', 'arrow-up-right', 'caret-right', 'caret-left', 'user-plus'],
        class: 'group-hover:translate-x-1'
      },
      {
        icon: ['arrow-up-right'],
        class: 'group-hover:translate-x-1 group-hover:-translate-y-[2px]'
      },
      {
        icon: ['arrow-down', 'download'],
        class: 'group-hover:translate-y-[2px]'
      }
    ]
  )
%}

{% set icon_classes =
  icon_variants.apply({
    icon: icon|default('arrow-right')
  })
%}

{# Normalize btn_classes - handle both array and string formats #}
{% set additional_classes = btn_classes|default('') %}
{% if additional_classes is iterable %}
  {% set additional_classes = additional_classes|join(' ') %}
{% endif %}

{# If href is provided and button is not disabled, present a link; otherwise render a button #}
{% set disabled_attr = is_disabled ? 'aria-disabled="true"' : '' %}
{% set button_disabled_attr = is_disabled ? 'disabled' : '' %}
{% set href = disabled|default(false) ? null : href %}

{% if href %}
  <a
    href="{{ href }}"
    class="{{
    button_variants.apply(
      {
        variant: button_variant,
        fullWidth: is_full_width
      },
      additional_classes
    )
    }}"
    {{ disabled_attr }}
  >
    {{ label }}
    {% if has_icon %}
      <span class="{{ icon_classes }}">
        {{
          include(
            '@drupalorg/components/icon/icon.twig',
            {
              icon: icon,
              icon_size: 'extra-small'
            },
            with_context: false
          )
        }}
      </span>
    {% endif %}
  </a>
{% else %}
  <button
    class="{{
    button_variants.apply(
      {
        variant: button_variant,
        fullWidth: is_full_width
      },
      additional_classes
    )
    }}"
    {{ button_disabled_attr }}
  >
    {{ label }}
    {% if has_icon %}
      <span class="{{ icon_classes }}">
        {{
          include(
            '@drupalorg/components/icon/icon.twig',
            {
              icon: icon,
              icon_size: 'extra-small'
            },
            with_context: false
          )
        }}
      </span>
    {% endif %}
  </button>
{% endif %}
