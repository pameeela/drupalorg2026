{% set text_text_size = text_size|default('normal') %}

{% set text_component =
  html_cva(
    base: [],
    variants: {
      textSize: {
        'text-xs': 'text-xs',
        'text-sm': 'text-sm',
        normal: 'text-base',
        'text-lg': 'text-lg xl:text-xl',
        'text-xl': 'text-xl xl:text-2xl',
        'text-2xl': 'text-2xl xl:text-3xl',
        'text-3xl': 'text-3xl xl:text-4xl'
      }
    }
  )
%}

{% set text_classes =
  text_component.apply({
    textSize: text_text_size
  })
%}

<div class="{{ text_classes }}">
  {{ text }}
</div>
