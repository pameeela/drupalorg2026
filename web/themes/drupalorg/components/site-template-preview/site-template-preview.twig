{#
  Full-page screenshot preview: scroll (detail), hover (cards), or static crop.
  Detail scroll with 2+ screenshots shows a thumbnail strip to swap the main frame.
#}

{% set preview_mode = mode|default('scroll') %}
{% set preview_size = size|default('detail') %}
{% set show_browser_chrome = show_chrome ?? true %}

{# Normalize media: Canvas may pass an image list, or a legacy single image object. #}
{% set screenshot_list = [] %}
{% if media is defined and media is not empty %}
  {% if media.src is defined %}
    {% set screenshot_list = [media] %}
  {% elseif media is iterable %}
    {% set screenshot_list = media %}
  {% endif %}
{% endif %}

{% set active_media = screenshot_list|first|default({}) %}
{% set has_media = active_media.src is defined and active_media.src is not empty %}
{% set screenshot_count = screenshot_list|length %}
{% set show_thumb_strip = preview_mode == 'scroll' and screenshot_count > 1 %}
{% set has_caption = caption is not empty %}
{% set is_hover_mode = preview_mode == 'hover' %}
{% set is_card_size = preview_size == 'card' or preview_size == 'mobile' %}
{% set show_fade_caption = has_caption and not is_card_size %}
{% set show_chip_caption = has_caption and is_card_size %}
{% set viewport_tabindex = is_hover_mode ? '0' : '-1' %}
{% set has_strip = show_thumb_strip ? 'yes' : 'no' %}

{% set additional_classes = preview_classes|default('') %}
{% if additional_classes is iterable %}
  {% set additional_classes = additional_classes|join(' ') %}
{% endif %}

{% set chrome_label =
  chrome_url
    |default('')
    |replace({
      'https://': '',
      'http://': ''
    })
    |trim('/')
%}

{% set height_values = {
  detail: '600px',
  featured: '470px',
  card: '450px',
  mobile: '315px'
} %}
{% set height_value = height_values[preview_size]|default('600px') %}
{% set style_attr = '--stp-height: ' ~ height_value %}

{% set preview =
  html_cva(
    base: ['site-template-preview', 'w-full'],
    variants: {
      hasStrip: {
        yes: 'flex flex-col gap-6',
        no: ''
      }
    }
  )
%}

{% set frame =
  html_cva(base: ['overflow-hidden', 'rounded-xl', 'border', 'border-navy/12', 'bg-white', 'shadow-[0_18px_40px_rgba(10,26,58,0.14)]'])
%}

{% set chrome =
  html_cva(base: ['flex', 'h-[38px]', 'shrink-0', 'items-center', 'gap-3', 'border-b', 'border-light-gray', 'bg-lightest-gray', 'px-3'])
%}

{% set viewport =
  html_cva(
    base: ['site-template-preview__viewport', 'relative', 'w-full', 'bg-light-gray'],
    variants: {
      mode: {
        scroll: 'site-template-preview__viewport--scroll overflow-y-auto',
        hover: 'site-template-preview__viewport--hover overflow-hidden',
        static: 'site-template-preview__viewport--static overflow-hidden'
      },
      size: {
        detail: 'h-[300px] md:h-[600px]',
        featured: 'h-[470px]',
        card: 'h-[450px]',
        mobile: 'h-[315px]'
      }
    }
  )
%}

{% set image =
  html_cva(
    base: ['site-template-preview__image', 'block', 'w-full', 'max-w-none'],
    variants: {
      mode: {
        scroll: 'h-auto',
        hover: ['site-template-preview__image--hover', 'absolute', 'inset-x-0', 'top-0'],
        static: ['absolute', 'inset-x-0', 'top-0', 'h-auto']
      }
    }
  )
%}

{% set caption_overlay =
  html_cva(
    base: [
      'site-template-preview__caption-overlay',
      'pointer-events-none',
      'absolute',
      'inset-0',
      'z-10',
      'm-auto',
      'flex',
      'h-fit',
      'w-fit',
      'items-center',
      'justify-center',
      'gap-1.5',
      'rounded-full',
      'bg-white/80',
      'px-3',
      'py-1.5',
      'text-sm',
      'font-normal',
      'text-navy',
      'text-pretty',
      'shadow-sm',
      'backdrop-blur-sm'
    ]
  )
%}

{% set caption_chip =
  html_cva(
    base: [
      'pointer-events-none',
      'absolute',
      'bottom-3',
      'left-1/2',
      'z-10',
      'flex',
      'w-fit',
      '-translate-x-1/2',
      'items-center',
      'justify-center',
      'gap-1.5',
      'rounded-full',
      'bg-darkest-blue/45',
      'px-2.5',
      'py-1',
      'text-[11px]',
      'leading-none',
      'font-medium',
      'tracking-[0.5px]',
      'text-white',
      'text-pretty',
      'backdrop-blur-[8px]'
    ]
  )
%}

{% set thumb_strip = html_cva(base: ['site-template-preview__thumbs', 'flex', 'flex-wrap', 'items-start', 'gap-3']) %}

{% set thumb_button =
  html_cva(
    base: [
      'site-template-preview__thumb',
      'relative',
      'h-24',
      'w-[150px]',
      'shrink-0',
      'cursor-pointer',
      'overflow-hidden',
      'rounded-md',
      'bg-light-gray',
      'p-0',
      'focus-visible:ring-2',
      'focus-visible:ring-drupal-blue/50'
    ]
  )
%}

{% set thumb_image = html_cva(base: ['pointer-events-none', 'absolute', 'inset-x-0', 'top-0', 'h-auto', 'w-full', 'max-w-none']) %}

{% set viewport_shell = html_cva(base: ['relative']) %}

{% set image_classes =
  image.apply({
    mode: preview_mode
  })
%}

{% set attributes =
  attributes.addClass(
    preview.apply(
      {
        hasStrip: has_strip
      },
      additional_classes
    )
  ).setAttribute(
    'style',
    style_attr
  )
%}

<div {{ attributes }}>
  <div class="{{ frame.apply({}) }}">
    {% if show_browser_chrome %}
      <div class="{{ chrome.apply({}) }}" aria-hidden="true">
        <div class="flex items-center gap-1.5">
          <span class="size-[9px] rounded-full bg-medium-gray"></span>
          <span class="size-[9px] rounded-full bg-medium-gray"></span>
          <span class="size-[9px] rounded-full bg-medium-gray"></span>
        </div>
        {% if chrome_label is not empty %}
          <div class="min-w-0 flex-1 truncate rounded-full bg-white px-3 py-1 text-center text-[12px] leading-none text-dark-gray">
            {{ chrome_label }}
          </div>
        {% else %}
          <div class="min-w-0 flex-1"></div>
        {% endif %}
      </div>
    {% endif %}

    <div class="{{ viewport_shell.apply({}) }}">
      <div
        class="{{
        viewport.apply({
          mode: preview_mode,
          size: preview_size
        })
        }}"
        tabindex="{{ viewport_tabindex }}"
        data-site-template-preview-viewport
      >
        {% if has_media %}
          {% include 'canvas:image' ignore missing with {
            src: active_media.src,
            alt: active_media.alt|default(''),
            class: image_classes,
            width: active_media.width,
            height: active_media.height,
            loading: 'lazy'
          } only %}
        {% else %}
          <div class="flex h-full min-h-full items-center justify-center text-sm text-dark-gray">
            No screenshot
          </div>
        {% endif %}
      </div>

      {% if show_fade_caption %}
        <div class="{{ caption_overlay.apply({}) }}" aria-hidden="true">
          {{
            include(
              '@drupalorg/components/icon/icon.twig',
              {
                icon: 'arrow-down',
                icon_size: 'extra-extra-small',
                icon_color: 'brand-blue'
              },
              with_context: false
            )
          }}
          <span>{{ caption }}</span>
        </div>
      {% endif %}

      {% if show_chip_caption %}
        <div class="{{ caption_chip.apply({}) }}" aria-hidden="true">
          {{
            include(
              '@drupalorg/components/icon/icon.twig',
              {
                icon: 'arrow-down',
                icon_size: 'extra-extra-small',
                icon_color: 'white'
              },
              with_context: false
            )
          }}
          <span>{{ caption }}</span>
        </div>
      {% endif %}
    </div>
  </div>

  {% if show_thumb_strip %}
    <div class="{{ thumb_strip.apply({}) }}" role="tablist" aria-label="Screenshots">
      {% for shot in screenshot_list %}
        {% if shot.src is defined and shot.src is not empty %}
          {% set thumb_alt = shot.alt|default('Screenshot ' ~ loop.index) %}
          {% set thumb_label = 'Show screenshot: ' ~ thumb_alt %}
          {% set thumb_tabindex = loop.first ? '0' : '-1' %}
          {% set thumb_selected = loop.first ? 'true' : 'false' %}
          <button
            type="button"
            class="{{ thumb_button.apply({}) }}"
            role="tab"
            aria-selected="{{ thumb_selected }}"
            aria-label="{{ thumb_label }}"
            tabindex="{{ thumb_tabindex }}"
            data-site-template-preview-thumb
            data-src="{{ shot.src }}"
            data-alt="{{ thumb_alt }}"
            data-width="{{ shot.width|default('') }}"
            data-height="{{ shot.height|default('') }}"
          >
            {% include 'canvas:image' ignore missing with {
              src: shot.src,
              alt: '',
              class: thumb_image.apply({}),
              width: shot.width,
              height: shot.height,
              loading: 'lazy'
            } only %}
          </button>
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}
</div>
