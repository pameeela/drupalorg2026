{% set dropdown_menu =
  html_cva(
    base: ['navbar--dropdown-menu', 'flex flex-col items-stretch justify-start gap-2 md:flex-row', 'max-h-full', 'overflow-auto md:overflow-visible'],
    variants: {
      menuAlign: {
        left: 'md:justify-start',
        center: 'md:justify-center',
        right: 'md:justify-end'
      }
    }
  )
%}

{% set dropdown_menu_classes =
  dropdown_menu.apply({
    menuAlign: menu_align|default('center')
  })
%}

{#
  Desktop: static so mega panels position against .region-header (full width).
  Mobile: relative for z-index / modal stacking.
#}
<div class="navbar relative z-[500] container mx-auto flex h-14 items-center justify-between px-4 md:static md:z-auto md:h-20 lg:px-12">
  <div class="navbar--logo flex items-center gap-9 self-center [&>div]:flex [&>div]:flex-col [&>div]:justify-center">
    {% block logo %}
      {{ include('@drupalorg/templates/block/block--system-branding-block.html.twig') }}
    {% endblock %}
  </div>

  <div
    id="navbar-main-menu"
    class="navbar--menu fixed inset-0 top-[calc(var(--drupal-displace-offset-top,0px)+var(--gin-toolbar-height,0px)-var(--navbar-scroll-top,0px))] grid max-w-full min-w-0 shrink-1 grow-1 grid-cols-[1fr] grid-rows-[auto_1fr_auto] flex-col items-stretch justify-start overflow-x-hidden overflow-y-auto bg-white pb-8 md:static md:flex md:h-auto md:flex-1 md:flex-row md:items-center md:justify-between md:gap-9 md:overflow-visible md:bg-transparent md:pb-0"
  >
    <div
      class="navbar--modal-top relative z-[500] col-span-1 col-start-1 row-span-1 row-start-1 container mx-auto flex w-full max-w-full min-w-0 justify-between p-2 md:hidden"
    >
      <div
        class="navbar--modal-logo flex min-h-[44px] flex-1 flex-col items-start justify-center md:hidden [&>div]:flex [&>div]:flex-col [&>div]:justify-center"
      >
        {{ block('logo') }}
      </div>

      <button
        type="button"
        class="navbar--hide-menu flex h-[44px] w-[44px] flex-0 cursor-pointer items-center justify-center p-2 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-drupal-blue md:hidden"
        aria-label="{{ 'Hide menu'|t }}"
      >
        {{
          include(
            '@drupalorg/components/icon/icon.twig',
            {
              icon: 'x',
              icon_size: 'medium'
            }
          )
        }}
      </button>
    </div>

    <div
      class="navbar--dropdown-menu-wrapper relative col-span-1 col-start-1 row-span-1 row-start-2 container mx-auto min-h-0 w-full max-w-full min-w-0 flex-1 overflow-x-hidden overflow-y-auto p-2 px-4 after:pointer-events-none after:absolute after:bottom-0 after:z-3 after:h-24 after:w-full after:bg-linear-to-b after:from-transparent after:to-white after:content-[''] md:static md:overflow-visible md:p-0 md:after:content-none"
    >
      <div class="{{ dropdown_menu_classes }}">
        {% block navigation %}

        {% endblock %}
      </div>
    </div>

    <div
      class="navbar--links col-span-1 col-start-1 row-span-1 row-start-3 flex w-full max-w-full min-w-0 flex-initial shrink-0 grow-0 flex-col justify-end gap-2 px-6 md:ml-auto md:w-auto md:flex-row md:p-0"
    >
      {% block links %}
        {{
          include(
            'drupalorg:button',
            {
              variant: 'primary',
              label: 'Button'|t,
              icon: 'arrow-right',
              href: 'https://example.com'
            }
          )
        }}

        {{
          include(
            'drupalorg:button',
            {
              variant: 'white',
              label: 'Another'|t,
              icon: 'arrow-right',
              href: 'https://example.com'
            }
          )
        }}
      {% endblock %}
    </div>
  </div>

  <div class="navbar--hamburger-container flex min-h-[44px] min-w-[44px] shrink-0 grow-0 items-center justify-center md:hidden">
    <button
      type="button"
      class="navbar--hamburger flex items-center justify-center focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-drupal-blue"
      aria-label="{{ 'Show menu'|t }}"
      aria-expanded="false"
      aria-controls="navbar-main-menu"
    >
      {{
        include(
          '@drupalorg/components/icon/icon.twig',
          {
            icon: 'list',
            icon_size: 'medium'
          }
        )
      }}
    </button>
  </div>
</div>
